# Neon connection string (use the dev branch locally, production branch on Vercel)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Shared temporary password given to every new account (must be changed at first sign-in)
TEMP_PASSWORD=ChangeMe-Temp-2026

# Admin account created by `npm run db:seed`
ADMIN_EMAIL=mohammed@emqube.com
ADMIN_NAME=Mohammed

# Vercel Cron sends this as "Authorization: Bearer <value>" (Vercel sets it automatically when CRON_SECRET exists)
CRON_SECRET=generate-a-long-random-string
